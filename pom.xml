<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.asdasfa</groupId>
    <artifactId>jbs2bg</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>jBS2BG</name>

    <!--
        Transitional Java 25 verification build (issue #94).

        This POM is a prefactoring checkpoint, NOT the complete application gate: the compiler plugin below still
        admits only the packages that compile without JavaFX 8 skin internals (data, project, presentation) until
        the JavaFX 25 UI port removes the source exclusions (#81).
        Every version here is pinned on purpose. Run tools/java25/verify-java25.ps1 for the reproducible run; it
        provisions the checksum-verified Temurin 25 toolchain that .mvn/toolchains.xml points at and fails closed
        on any drift. The Maven host JDK may be newer (e.g. JDK 26) but compilation and tests always fork the
        toolchain JDK selected by maven-toolchains-plugin.
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.4</javafx.version>
        <maven.compiler.release>25</maven.compiler.release>
        <junit.version>5.11.4</junit.version>

        <!-- Pinned build inputs; tools/java25/toolchain-lock.json mirrors the Maven distribution and JDK pins. -->
        <bs2bg.maven.version>3.9.16</bs2bg.maven.version>
        <bs2bg.toolchain.jdk.version>25</bs2bg.toolchain.jdk.version>
        <bs2bg.toolchain.jdk.vendor>temurin</bs2bg.toolchain.jdk.vendor>
        <!--
            Full Temurin build that must own the test JVM. Surefire forwards it to Java25ToolchainGuardTest, and
            tools/java25/verify-java25.ps1 fails closed if it differs from jdk.release.JAVA_RUNTIME_VERSION in the lock.
        -->
        <bs2bg.toolchain.jdk.runtimeVersion>25.0.4.1+1-LTS</bs2bg.toolchain.jdk.runtimeVersion>

        <!-- Material lifecycle and verification plugins, pinned so the default bindings cannot drift. -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-toolchains-plugin.version>3.2.0</maven-toolchains-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.eclipsesource.minimal-json</groupId>
            <artifactId>minimal-json</artifactId>
            <version>0.9.5</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.6</version>
        </dependency>
        <dependency>
            <groupId>com.github.albfernandez</groupId>
            <artifactId>juniversalchardet</artifactId>
            <version>2.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>test</testSourceDirectory>
        <resources>
            <resource>
                <directory>src</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>assets</directory>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>test-resources</directory>
            </testResource>
        </testResources>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-toolchains-plugin</artifactId>
                    <version>${maven-toolchains-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Fail closed on any drift in the Maven distribution, host JDK, architecture, or plugin/dependency pins. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-pinned-build-inputs</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[${bs2bg.maven.version}]</version>
                                    <message>The build must run through the committed Maven Wrapper (Apache Maven ${bs2bg.maven.version}).</message>
                                </requireMavenVersion>
                                <!-- The Maven host JDK may be newer than the toolchain, but never older than the target release. -->
                                <requireJavaVersion>
                                    <version>[${bs2bg.toolchain.jdk.version},)</version>
                                    <message>Maven must be bootstrapped by JDK ${bs2bg.toolchain.jdk.version} or newer; compilation and tests use the toolchain JDK.</message>
                                </requireJavaVersion>
                                <requireOS>
                                    <family>windows</family>
                                    <arch>amd64</arch>
                                    <message>The transitional Java 25 checkpoint is pinned to Windows x64.</message>
                                </requireOS>
                                <requirePluginVersions>
                                    <banLatest>true</banLatest>
                                    <banRelease>true</banRelease>
                                    <banSnapshots>true</banSnapshots>
                                    <phases>clean,deploy</phases>
                                    <message>Every lifecycle plugin must be pinned to an explicit version.</message>
                                </requirePluginVersions>
                                <banDynamicVersions>
                                    <message>Dependency versions must be exact; ranges, LATEST, and RELEASE are banned.</message>
                                </banDynamicVersions>
                                <!-- JavaFX incubator modules are not part of the accepted JavaFX 25 surface. -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.openjfx:javafx-incubator-*</exclude>
                                    </excludes>
                                    <message>JavaFX incubator modules stay disabled in the transitional build.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Select the provisioned Temurin 25 JDK for compilation and tests. .mvn/toolchains.xml resolves
                BS2BG_JDK25_HOME, which tools/java25/verify-java25.ps1 exports after verifying the JDK checksum
                and release metadata. Without a matching toolchain the build fails instead of silently using the
                Maven host JDK.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <executions>
                    <execution>
                        <id>select-java25-toolchain</id>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>${bs2bg.toolchain.jdk.version}</version>
                            <vendor>${bs2bg.toolchain.jdk.vendor}</vendor>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                    TRANSITIONAL: the verification build excludes JavaFX 8 skin internals until the JavaFX 25 UI
                    port (#81). Only the packages listed below are compiled, so a green run here is not evidence
                    that the complete application builds. Preview features stay disabled: no enable-preview flag
                    may be added to compilerArgs or to the Surefire argLine.
                -->
                <configuration>
                    <implicit>none</implicit>
                    <includes>
                        <include>com/asdasfa/jbs2bg/data/**/*.java</include>
                        <include>com/asdasfa/jbs2bg/project/**/*.java</include>
                        <include>com/asdasfa/jbs2bg/presentation/**/*.java</include>
                    </includes>
                    <compilerArgs>
                        <arg>-sourcepath</arg>
                        <arg>${project.build.directory}/empty-sourcepath</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- No argLine: adding enable-preview here would silently reopen preview features for the tests. -->
                <configuration>
                    <systemPropertyVariables>
                        <bs2bg.toolchain.jdk.runtimeVersion>${bs2bg.toolchain.jdk.runtimeVersion}</bs2bg.toolchain.jdk.runtimeVersion>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
