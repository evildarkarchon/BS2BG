<?xml version="1.0" encoding="UTF-8"?>

<?import com.asdasfa.jbs2bg.workbench.output.OutputDrawerParts?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<OutputDrawerParts fx:id="parts" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.asdasfa.jbs2bg.workbench.output.OutputDrawer">
    <generateButton>
        <Button fx:id="generateOutputButton" accessibleText="Generate Project output"
                mnemonicParsing="true" text="_Generate" />
    </generateButton>
    <drawer>
        <VBox fx:id="outputDrawer" accessibleText="Output" alignment="TOP_LEFT"
                managed="false" prefHeight="220.0" spacing="8.0" styleClass="output-drawer"
                visible="false" StackPane.alignment="BOTTOM_CENTER">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label fx:id="outputFocusTarget" accessibleText="Output generated text"
                                focusTraversable="true" styleClass="title output-focus-target"
                                text="Output" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="copyOutputButton" accessibleText="Copy selected Output artifact"
                                mnemonicParsing="true" text="_Copy" />
                        <Button fx:id="exportOutputButton" accessibleText="Export all Output artifacts"
                                mnemonicParsing="true" text="_Export All…" />
                        <Label text="Drawer height" />
                        <Slider fx:id="outputDrawerHeight" accessibleText="Output drawer height"
                                blockIncrement="20.0" majorTickUnit="40.0" max="360.0" min="140.0"
                                prefWidth="180.0" value="220.0" />
                    </children>
                </HBox>
                <TabPane fx:id="outputTabs" accessibleText="Generated Output tabs"
                        focusTraversable="true" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab fx:id="templatesOutputTab" text="Templates">
                            <content>
                                <TextArea fx:id="templatesOutputText"
                                        accessibleText="Generated Templates output" editable="false"
                                        focusTraversable="true" text="Generate Project output to inspect it here."
                                        styleClass="output-text" wrapText="false" />
                            </content>
                        </Tab>
                        <Tab fx:id="morphsOutputTab" text="Morphs">
                            <content>
                                <TextArea fx:id="morphsOutputText"
                                        accessibleText="Generated Morphs output" editable="false"
                                        focusTraversable="true" text="Generate Project output to inspect it here."
                                        styleClass="output-text" wrapText="false" />
                            </content>
                        </Tab>
                        <Tab fx:id="bosOutputTab" text="BoS JSON">
                            <content>
                                <VBox spacing="6.0">
                                    <children>
                                        <!-- Built ahead of its label: FXMLLoader leaves a forward labelFor null (#155). -->
                                        <fx:define>
                                            <ComboBox fx:id="bosArtifactChoice"
                                                    accessibleText="Generated BoS Slider Preset"
                                                    maxWidth="Infinity" />
                                        </fx:define>
                                        <Label labelFor="$bosArtifactChoice" mnemonicParsing="true"
                                                text="BoS Slider _Preset:" />
                                        <fx:reference source="bosArtifactChoice" />
                                        <TextArea fx:id="bosOutputText"
                                                accessibleText="Generated BoS JSON output" editable="false"
                                                focusTraversable="true"
                                                text="Generate Project output to inspect it here."
                                                styleClass="output-text" wrapText="false"
                                                VBox.vgrow="ALWAYS" />
                                        <Button fx:id="exportSelectedBosButton"
                                                accessibleText="Export selected BoS JSON artifact"
                                                mnemonicParsing="true" text="Export _Selected…" />
                                    </children>
                                </VBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </drawer>
</OutputDrawerParts>
