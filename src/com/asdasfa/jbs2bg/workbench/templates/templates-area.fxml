<?xml version="1.0" encoding="UTF-8"?>

<?import com.asdasfa.jbs2bg.workbench.AreaPanes?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    The Templates Area: three panes the shell mounts into its primary, editor and inspector landmark containers. The
    root is a non-Node holder, so this file has no layout of its own. Accessible text, visible text and nesting are
    exactly what they were in workbench.fxml; the packaged smoke run finds these controls by name, role and region.

    A control with a mnemonic label is built in an fx:define ahead of that label and placed with fx:reference.
    FXMLLoader leaves a forward labelFor="$id" null, which loses both the mnemonic and the accessible label (#155).
-->
<AreaPanes fx:id="panes" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.asdasfa.jbs2bg.workbench.templates.TemplatesArea">
    <primary>
        <ScrollPane fx:id="templatesPrimaryScroll"
                accessibleText="Slider Preset management"
                fitToWidth="true" focusTraversable="false"
                hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="templatesPrimaryContent" spacing="6.0">
                    <children>
                <HBox fx:id="templatesInfoBar"
                        accessibleText="Templates notification"
                        alignment="CENTER_LEFT"
                        focusTraversable="false" managed="false"
                        spacing="6.0" styleClass="info-bar templates-info-bar"
                        visible="false">
                    <padding>
                        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
                    </padding>
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="templatesInfoBarCue"
                                        styleClass="feedback-cue"
                                        text="Validation" />
                                <Label fx:id="templatesInfoBarMessage"
                                        text="Validation message"
                                        wrapText="true" />
                            </children>
                        </VBox>
                        <Button fx:id="dismissTemplatesInfoBarButton"
                                accessibleText="Dismiss Templates validation"
                                mnemonicParsing="true" text="_Dismiss" />
                    </children>
                </HBox>
                <fx:define>
                    <TextField fx:id="sliderPresetFilter"
                            accessibleText="Filter Slider Presets"
                            promptText="Filter by name" />
                </fx:define>
                <Label labelFor="$sliderPresetFilter"
                        mnemonicParsing="true"
                        text="_Filter Slider Presets:" />
                <fx:reference source="sliderPresetFilter" />
                <fx:define>
                    <ComboBox fx:id="sliderPresetSort"
                            accessibleText="Slider Preset sort"
                            maxWidth="Infinity" />
                </fx:define>
                <Label labelFor="$sliderPresetSort"
                        mnemonicParsing="true"
                        text="_Sort Slider Presets:" />
                <fx:reference source="sliderPresetSort" />
                <ListView fx:id="sliderPresetList"
                        accessibleText="Slider Presets"
                        fixedCellSize="28.0"
                        focusTraversable="true"
                        VBox.vgrow="ALWAYS" />
                <fx:define>
                    <TextField fx:id="sliderPresetNameInput"
                            accessibleText="Slider Preset name"
                            promptText="New or duplicate name" />
                </fx:define>
                <Label labelFor="$sliderPresetNameInput"
                        mnemonicParsing="true"
                        text="_Slider Preset name:" />
                <fx:reference source="sliderPresetNameInput" />
                <Button fx:id="createSliderPresetButton"
                        accessibleText="Create Slider Preset"
                        maxWidth="Infinity" mnemonicParsing="true"
                        text="_Create Slider Preset" />
                <Button fx:id="duplicateSliderPresetButton"
                        accessibleText="Duplicate Slider Preset"
                        maxWidth="Infinity" mnemonicParsing="true"
                        text="_Duplicate Slider Preset" />
                <Button fx:id="removeSliderPresetButton"
                        accessibleText="Remove Slider Preset"
                        maxWidth="Infinity" mnemonicParsing="true"
                        text="_Remove Slider Preset" />
                <Button fx:id="clearSliderPresetsButton"
                        accessibleText="Clear visible Slider Presets"
                        maxWidth="Infinity" mnemonicParsing="true"
                        text="C_lear visible Slider Presets" />
                <Button fx:id="importBodySlideButton"
                        accessibleText="Import BodySlide Presets"
                        maxWidth="Infinity" mnemonicParsing="true"
                        text="_Import BodySlide Presets…" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </primary>
    <editor>
        <VBox fx:id="templatesEditorContent" alignment="TOP_LEFT"
                spacing="8.0">
            <children>
                <Label fx:id="templateEditorFocusTarget"
                        accessibleText="Templates editor"
                        focusTraversable="true" styleClass="title"
                        text="No Slider Preset selected" />
                <Label fx:id="templateProfileText"
                        accessibleText="Slider Preset profile"
                        text="Select a Slider Preset to browse its profile." />
                <Label fx:id="templateChoiceCountText"
                        accessibleText="Slider choice count"
                        text="No slider choices" />
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <fx:define>
                            <ComboBox fx:id="sliderPresetProfile"
                                    accessibleText="Slider Preset profile"
                                    disable="true" maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS" />
                        </fx:define>
                        <!-- Keep the mnemonic legible when the ComboBox absorbs editor width. -->
                        <Label labelFor="$sliderPresetProfile"
                                minWidth="72.0" mnemonicParsing="true"
                                text="_Profile:" />
                        <fx:reference source="sliderPresetProfile" />
                    </children>
                </HBox>
                <ScrollPane fx:id="sliderChoicesScroll"
                        accessibleText="Set Sliders editor"
                        fitToWidth="true" focusTraversable="false"
                        hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="sliderChoiceRows" spacing="8.0" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </editor>
    <inspector>
        <ScrollPane fx:id="templatesInspectorScroll"
                accessibleText="Templates inspector controls"
                fitToWidth="true" focusTraversable="false"
                hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="templatesInspectorContent" spacing="8.0">
                    <children>
                        <Label text="Slider Preset inspector" />
                        <Label fx:id="templateSelectionText"
                                accessibleText="Selected Slider Preset"
                                focusTraversable="true"
                                text="No Slider Preset selected" wrapText="true" />
                        <Button fx:id="goToSetSlidersButton"
                                accessibleText="Go to Set Sliders"
                                maxWidth="Infinity" mnemonicParsing="true"
                                text="_Go to Set Sliders" />
                        <Button fx:id="renameSliderPresetButton"
                                accessibleText="Rename selected Slider Preset"
                                maxWidth="Infinity" mnemonicParsing="true"
                                text="_Rename Slider Preset (F2)" />
                        <Label styleClass="title" text="Gang controls" />
                        <Label text="Set every enabled Slider choice atomically."
                                wrapText="true" />
                        <HBox spacing="4.0">
                            <children>
                                <Button fx:id="zeroAllSliderChoicesButton"
                                        accessibleText="Set all Slider choice values to 0 percent"
                                        maxWidth="Infinity" text="0 All"
                                        HBox.hgrow="ALWAYS" />
                                <Button fx:id="fiftyAllSliderChoicesButton"
                                        accessibleText="Set all Slider choice values to 50 percent"
                                        maxWidth="Infinity" text="50 All"
                                        HBox.hgrow="ALWAYS" />
                                <Button fx:id="hundredAllSliderChoicesButton"
                                        accessibleText="Set all Slider choice values to 100 percent"
                                        maxWidth="Infinity" text="100 All"
                                        HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <HBox spacing="4.0">
                            <children>
                                <Button fx:id="zeroAllMinimumButton"
                                        accessibleText="Set all Slider choice minimum values toward 0 percent without crossing each maximum"
                                        maxWidth="Infinity" text="0 All-Min"
                                        HBox.hgrow="ALWAYS" />
                                <Button fx:id="fiftyAllMinimumButton"
                                        accessibleText="Set all Slider choice minimum values toward 50 percent without crossing each maximum"
                                        maxWidth="Infinity" text="50 All-Min"
                                        HBox.hgrow="ALWAYS" />
                                <Button fx:id="hundredAllMinimumButton"
                                        accessibleText="Set all Slider choice minimum values toward 100 percent without crossing each maximum"
                                        maxWidth="Infinity" text="100 All-Min"
                                        HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <HBox spacing="4.0">
                            <children>
                                <Button fx:id="zeroAllMaximumButton"
                                        accessibleText="Set all Slider choice maximum values toward 0 percent without crossing each minimum"
                                        maxWidth="Infinity" text="0 All-Max"
                                        HBox.hgrow="ALWAYS" />
                                <Button fx:id="fiftyAllMaximumButton"
                                        accessibleText="Set all Slider choice maximum values toward 50 percent without crossing each minimum"
                                        maxWidth="Infinity" text="50 All-Max"
                                        HBox.hgrow="ALWAYS" />
                                <Button fx:id="hundredAllMaximumButton"
                                        accessibleText="Set all Slider choice maximum values toward 100 percent without crossing each minimum"
                                        maxWidth="Infinity" text="100 All-Max"
                                        HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <CheckBox fx:id="gangAllCheck"
                                accessibleText="Gang all Slider choice values"
                                mnemonicParsing="true" text="Gang _All" />
                        <Slider fx:id="gangAllSlider"
                                accessibleText="Gang all Slider choice value"
                                blockIncrement="1.0" majorTickUnit="20.0"
                                max="100.0" min="0.0" value="100.0" />
                        <Label fx:id="gangAllValue" text="100%" />
                        <CheckBox fx:id="gangMinimumCheck"
                                accessibleHelp="Minimum values stop at each Slider choice maximum."
                                accessibleText="Gang all minimum Slider choice values"
                                mnemonicParsing="true" text="Gang All _Minimum" />
                        <Slider fx:id="gangMinimumSlider"
                                accessibleText="Gang all minimum Slider choice value"
                                blockIncrement="1.0" majorTickUnit="20.0"
                                max="100.0" min="0.0" value="100.0" />
                        <Label fx:id="gangMinimumValue" text="100%" />
                        <CheckBox fx:id="gangMaximumCheck"
                                accessibleHelp="Maximum values stop at each Slider choice minimum."
                                accessibleText="Gang all maximum Slider choice values"
                                mnemonicParsing="true" text="Gang All Ma_ximum" />
                        <Slider fx:id="gangMaximumSlider"
                                accessibleText="Gang all maximum Slider choice value"
                                blockIncrement="1.0" majorTickUnit="20.0"
                                max="100.0" min="0.0" value="100.0" />
                        <Label fx:id="gangMaximumValue" text="100%" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </inspector>
</AreaPanes>
